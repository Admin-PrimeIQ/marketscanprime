model projects {
  id                      Int       @id @default(autoincrement()) @db.UnsignedInt
  document_id             String?   @db.VarChar(255)
  code                    String?   @db.VarChar(255)
  name                    String?   @db.VarChar(255)
  department              String?   @db.VarChar(255)
  municipality            String?   @db.VarChar(255)
  zone                    String?   @db.VarChar(255)
  subzone                 String?   @db.VarChar(255)
  latitude                Decimal?  @db.Decimal(10, 8)
  longitude               Decimal?  @db.Decimal(10, 8)
  muvi                    Boolean?
  showroom                Boolean?
  model_house             Boolean?
  access_quantity         Int?
  image_url               String?   @db.VarChar(255)
  created_at              DateTime? @db.DateTime(6)
  updated_at              DateTime? @db.DateTime(6)
  published_at            DateTime? @db.DateTime(6)
  created_by_id           Int?      @db.UnsignedInt
  updated_by_id           Int?      @db.UnsignedInt
  locale                  String?   @db.VarChar(255)
  fha                     Boolean?
  fractional_down_payment Boolean?
  down_payment_percentage Decimal?  @db.Decimal(10, 2)

  amenities_lnk             projects_amenities_lnk[]
  country_lnk               projects_country_lnk[]
  developer_lnk             projects_developer_lnk[]
  exchange_rate_profile_lnk projects_exchange_rate_profile_lnk[]
  nse_lnk                   projects_nse_lnk[]
  security_type_lnk         projects_security_type_lnk[]
  services_lnk              services_projects_lnk[]
  blocks_lnk                blocks_project_lnk[]
}

model projects_amenities_lnk {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
