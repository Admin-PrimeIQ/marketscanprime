# Plantilla del .env único de la raíz (git lo ignora) para el backend prisma: la app, el lanzador y
# el ETL (etl/) leen solo ese archivo; no crear .env.local ni .env.staging.local. Local:
# `pnpm dev:staging` (o `pnpm dev`); el lanzador se niega a arrancar si encuentra credenciales de
# Strapi o de sync. Hoy solo los catálogos y el login usan la base nueva; el resto de pantallas avisa
# que su módulo no está migrado. El login usa los usuarios de msp_app (misma clave que en Strapi).

NEXT_PUBLIC_DATA_BACKEND=prisma

# Postgres nuevo (Railway), esquema msp_app: las mismas credenciales con las que escribe el ETL
# (etl/), nunca las de producción. En la clave, codifica % como %25 y luego # como %23.
DATABASE_URL_APP=postgresql://usuario:clave@host:puerto/railway

# Raíz del certificado de Railway. Por defecto etl/certs/dbo-stage-ca.pem, versionado e incluido en el
# deploy de Vercel (next.config.mjs). DATABASE_CA_APP solo hace falta si Railway rota la raíz.
# DATABASE_CA_FILE_APP=etl/certs/dbo-stage-ca.pem
# DATABASE_CA_APP=-----BEGIN CERTIFICATE-----...

# Solo en un despliegue de staging (Vercel), detrás de la protección de despliegues de Vercel:
# permite las Server Actions fuera de `next dev`. Nunca en el proyecto de producción.
# MSP_STAGING_DEPLOY=true
