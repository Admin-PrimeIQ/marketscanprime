  phase                        String?   @db.VarChar(255)
  tower                        String?   @db.VarChar(255)
  sector                       String?   @db.VarChar(255)
  year                         Int?
  collection_date              DateTime? @db.Date
  start_date                   DateTime? @db.Date
  delivery_date                DateTime? @db.Date
  commercialization_months     Int?
  total_units                  Int?
  total_m_2                    Decimal?  @db.Decimal(10, 2)
  available_units              Int?
  available_m_2                Decimal?  @db.Decimal(10, 2)
  visitor_parking              Int?
  assigned_parking             Int?
  total_project_parking        Int?
  mig_number                   Int?
  created_at                   DateTime? @db.DateTime(6)
  updated_at                   DateTime? @db.DateTime(6)
  published_at                 DateTime? @db.DateTime(6)
  created_by_id                Int?      @db.UnsignedInt
  updated_by_id                Int?      @db.UnsignedInt
  locale                       String?   @db.VarChar(255)
  legacy_id                    String?   @db.VarChar(255)
  code                         String?   @db.VarChar(255)
  name                         String?   @db.VarChar(255)
  quarter                      String?   @db.VarChar(255)
  average_price_usd            Decimal?  @db.Decimal(10, 2)
  average_size_m_2             Decimal?  @db.Decimal(10, 2)
  average_price_per_m_2_usd    Decimal?  @db.Decimal(10, 2)
  average_installment_usd      Decimal?  @db.Decimal(10, 2)
  average_income_usd           Decimal?  @db.Decimal(10, 2)
  additional_parking_price_usd Decimal?  @db.Decimal(10, 2)
  market                       String?   @db.VarChar(255)
  domain                       String?   @db.VarChar(255)
  parking_for_sale             Int?

  project_lnk        blocks_project_lnk[]
  block_category_lnk blocks_block_category_lnk[]
  block_focus_lnk    blocks_block_focus_lnk[]
  block_status_lnk   blocks_block_status_lnk[]
  cmps               blocks_cmps[]
  units_lnk          units_block_lnk[]
}

model blocks_project_lnk {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  block_id   Int?   @db.UnsignedInt
  project_id Int?   @db.UnsignedInt
  block_ord  Float? @db.Double

  block   blocks?   @relation(fields: [block_id], references: [id])
  project projects? @relation(fields: [project_id], references: [id])
}

model blocks_block_category_lnk {
  id                Int  @id @default(autoincrement()) @db.UnsignedInt
  block_id          Int? @db.UnsignedInt
  block_category_id Int? @db.UnsignedInt

  block          blocks?           @relation(fields: [block_id], references: [id])
  block_category block_categories? @relation(fields: [block_category_id], references: [id])
}

model blocks_block_focus_lnk {
  id             Int  @id @default(autoincrement()) @db.UnsignedInt
  block_id       Int? @db.UnsignedInt
  block_focus_id Int? @db.UnsignedInt

  block       blocks?        @relation(fields: [block_id], references: [id])
  block_focus block_focuses? @relation(fields: [block_focus_id], references: [id])
}

model blocks_block_status_lnk {
  id              Int  @id @default(autoincrement()) @db.UnsignedInt
  block_id        Int? @db.UnsignedInt
  block_status_id Int? @db.UnsignedInt

  block        blocks?         @relation(fields: [block_id], references: [id])
  block_status block_statuses? @relation(fields: [block_status_id], references: [id])
}

// Componente "financing" del bloque: component_type = 'financing.financing',
// cmp_id → components_financing_financings.id.
model blocks_cmps {
  id             Int     @id @default(autoincrement()) @db.UnsignedInt
  entity_id      Int?    @db.UnsignedInt
  cmp_id         Int?    @db.UnsignedInt
  component_type String? @db.VarChar(255)
  field          String? @db.VarChar(255)
  order          Float?  @db.Double

  entity blocks? @relation(fields: [entity_id], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Financiamiento del bloque (18 bancos)
// ─────────────────────────────────────────────────────────────────────────────

model components_financing_financings {
  id                                  Int      @id @default(autoincrement()) @db.UnsignedInt
  down_payment_percent                Decimal? @db.Decimal(10, 2)
  fractional_down_payment             Boolean?
  fractional_down_payment_fha         Decimal? @db.Decimal(10, 2)
  fractional_installments_other_banks Decimal? @db.Decimal(10, 2)
  min_down_payment_fha                Decimal? @db.Decimal(10, 2)
  min_down_payment_other_banks        Decimal? @db.Decimal(10, 2)
  max_loan_term_years_fha             Int?
  max_loan_term_years_banks           Int?
  max_loan_term_years_owner           Int?

  cmps components_financing_financings_cmps[]
}

// Una fila por banco: field = fha | bi | gtc | chn | banrural | bac | bam | bantrab |
// credicorp | internacional | promerica | azteca | inmobiliario | inv | ficohsa | vivibanco |
// antigua | ownerFinancing (lib/financing.ts → BANCOS); cmp_id → components_financing_bank_rates.id.
model components_financing_financings_cmps {
  id             Int     @id @default(autoincrement()) @db.UnsignedInt
  entity_id      Int?    @db.UnsignedInt
  cmp_id         Int?    @db.UnsignedInt
  component_type String? @db.VarChar(255)
  field          String? @db.VarChar(255)
  order          Float?  @db.Double

  entity components_financing_financings? @relation(fields: [entity_id], references: [id])
}

model components_financing_bank_rates {
  id                  Int      @id @default(autoincrement()) @db.UnsignedInt
  annual_rate_percent Decimal? @db.Decimal(10, 2)
}

