{
  "name": "market-scan-etl",
  "version": "0.1.0",
  "private": true,
  "description": "ETL de migración: lee la base MySQL de Strapi con Prisma (solo lectura) para cargar dbo_stage y el esquema nuevo.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "strapi:validate": "prisma validate --config prisma.strapi.config.ts",
    "strapi:generate": "prisma generate --config prisma.strapi.config.ts",
    "strapi:pull:print": "prisma db pull --print --config prisma.strapi.config.ts",
    "strapi:ping": "tsx src/strapi/ping.ts",
    "strapi:check": "tsx src/strapi/check.ts",
    "warehouse:ping": "tsx src/warehouse/ping.ts",
    "app:validate": "prisma validate --config prisma.app.config.ts",
    "app:generate": "prisma generate --config prisma.app.config.ts --generator client",
    "app:ping": "tsx src/app/ping.ts",
    "app:status": "tsx src/app/prisma-cli.ts migrate status",
    "app:deploy": "tsx src/app/prisma-cli.ts migrate deploy",
    "app:pull:print": "tsx src/app/prisma-cli.ts db pull --print",
    "app:local-user": "tsx src/app/local-user.ts",
    "stage:cert": "tsx src/stage/fetch-cert.ts",
    "stage:ping": "tsx src/stage/ping.ts",
    "stage:describe": "tsx src/stage/describe.ts",
    "load": "tsx src/load/index.ts run",
    "load:validate": "tsx src/load/index.ts validate",
    "load:verify": "tsx src/load/index.ts verify",
    "load:formulas": "tsx src/load/index.ts formulas",
    "rates:load": "tsx src/exchange-rates/index.ts load",
    "rates:parity": "tsx src/exchange-rates/index.ts parity",
    "counters:parity": "tsx src/block-counters/index.ts parity",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.4.7",
    "mariadb": "3.4.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
