{"nodes": [{"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_out_of_range_alert_spec", "label": "Out-of-Range Values Alert Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_out_of_range_alert", "label": "Out-of-range alert for price and maintenance per m2", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catches one-digit typos (exactly 10x) without blocking saves, since extremes can be legitimate."}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_self_contaminating_average", "label": "Self-contaminating average problem", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The suspect value raises its own threshold; with n <= F the rule can never fire."}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_leave_one_out_reference", "label": "Leave-one-out reference average", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(sum - x_i)/(n - 1) restores a true 8x threshold regardless of block size at O(1) per row."}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_nonzero_rows_only", "label": "Alert average over non-zero rows only", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Including empty rows would flag the first legitimate value in a new block."}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_min_sample_five", "label": "Minimum sample of 5 rows with value", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_symmetric_factor_eight", "label": "Symmetric factor-8 threshold", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omitting a digit is as likely as adding one; 8 tolerates legitimate variation yet catches 10x. Known limitation: two errors in a block can escape."}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_orange_cell_marking", "label": "Derived orange cell marking (two intensities)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark is derived from the value, never cleared on confirm, so accepted genuine errors stay auditable; paler once persisted."}, {"id": "docs_superpowers_specs_2026_08_05_units_out_of_range_alert_design_theme_priority_chain", "label": "Cell theme priority chain", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-05-units-out-of-range-alert-design.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_