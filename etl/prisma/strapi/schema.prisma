// Base MySQL "strapi" (RDS us-east-2), solo lectura.
//
// Escrito a mano desde el inventario de docs/manual-del-sistema.md (líneas 1571–1662).
// Incluye las 52 tablas migrables; se omiten admin_*, strapi_*, files*, upload_folders*,
// i18n_locale y up_permissions*. Nombres idénticos a la base para poder comparar contra
// `npm run strapi:pull:print`.
//
// NUNCA correr prisma migrate / db push / migrate reset contra esta base.
//
// Convenciones de Strapi v5:
// - Relaciones en tablas <tabla>_<campo>_lnk.
// - Componentes y zona dinámica en <tabla>_cmps: cmp_id es polimórfico según
//   component_type, por eso no tiene relación declarada.
// - created_by_id / updated_by_id apuntan a admin_users, que no se migra.

generator client {
  provider = "prisma-client"
  output   = "../../generated/strapi"
}

datasource db {
  provider = "mysql"
}

