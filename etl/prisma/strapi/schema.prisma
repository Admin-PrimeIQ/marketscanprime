  project_ord Float?  @db.Double

  project projects?  @relation(fields: [project_id], references: [id])
  amenity amenities? @relation(fields: [amenity_id], references: [id])
}

model projects_country_lnk {
  id         Int  @id @default(autoincrement()) @db.UnsignedInt
  project_id Int? @db.UnsignedInt
  country_id Int? @db.UnsignedInt

  project projects?  @relation(fields: [project_id], references: [id])
  country countries? @relation(fields: [country_id], references: [id])
}

model projects_developer_lnk {
  id           Int  @id @default(autoincrement()) @db.UnsignedInt
  project_id   Int? @db.UnsignedInt
  developer_id Int? @db.UnsignedInt

  project   projects?   @relation(fields: [project_id], references: [id])
  developer developers? @relation(fields: [developer_id], references: [id])
}

model projects_exchange_rate_profile_lnk {
  id                       Int    @id @default(autoincrement()) @db.UnsignedInt
  project_id               Int?   @db.UnsignedInt
  exchange_rate_profile_id Int?   @db.UnsignedInt
