// Esquema de la app nueva (Fase 2 del ROADMAP): Postgres de Railway, base `railway`, esquema `msp_app`.
//
// Reemplaza al modelo de Strapi (etl/prisma/strapi/schema.prisma):
// - Relaciones con llaves foráneas directas en lugar de tablas `_lnk`.
// - La zona dinámica `unitType` pasa a tres tablas 1:1 (`unit_housing`, `unit_office`, `unit_industrial`).
// - El financiamiento (4 tablas encadenadas, banco en `field`) pasa a `block_financing` + `block_bank_rate`.
// - Las monedas del perfil (4 niveles de componentes) pasan a `exchange_rate_profile_currency`.
//
// `publicId` es el `document_id` de Strapi en las filas cargadas (enlaza con el warehouse) y un
// cuid en las nuevas. Los valores de los enums son los que hoy guarda Strapi.
//
// Migraciones: `npm run app:diff` / `app:deploy` desde etl/. Nunca `migrate reset` ni `db push`:
// la base `railway` también contiene `dbo_stage`.

generator client {
  provider = "prisma-client"
  output   = "../etl/generated/app"
}

// Cliente de la app Next.js (lib/db/). Se genera desde la raíz con `pnpm db:generate`.
generator app {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// T1–T4 = GAM, S1–S2 = Interior (lib/region.ts).
enum Quarter {
  T1
  T2
  T3
  T4
  S1
  S2

  @@map("quarter")
}

enum BlockDomain {
  housing
  office
  industrial

  @@map("block_domain")
}

enum Market {
  Primary
  Secondary

  @@map("market")
}

/// Columna `uso` del universo del warehouse, 1:1.
enum BlockUsage {
  Venta
  Renta

  @@map("block_usage")
}

enum Availability {
  Available
  Not_Available @map("Not Available")

  @@map("availability")
}

/// Bancos del componente `financing.financing` (lib/financing.ts → BANCOS).
enum Bank {
  fha
  bi
  gtc
  chn
  banrural
  bac
  bam
  bantrab
  credicorp
  internacional
  promerica
  azteca
  inmobiliario
  inv
  ficohsa
  vivibanco
  antigua
  ownerFinancing

  @@map("bank")
}

enum Currency {
  GTQ
  MXN
  PAB
  BZD
  CRC
  NIO
  HNL

  @@map("currency")
}

/// lib/units/unit-type-dynamic-columns.ts → UNIT_OFFICE_CLASSIFICATION_VALUES
enum OfficeClassification {
  Micro_1  @map("Micro 1")
  Micro_2  @map("Micro 2")
  Small_1  @map("Small 1")
  Small_2  @map("Small 2")
  Medium_1 @map("Medium 1")
  Medium_2 @map("Medium 2")
  Medium_3 @map("Medium 3")
  Large_1  @map("Large 1")
  Large_2  @map("Large 2")
  Large_3  @map("Large 3")
  Large_4  @map("Large 4")
  Large_5  @map("Large 5")

  @@map("office_classification")
}

enum OfficeSizeClassification {
  Micro
  Small
  Medium
  Large

  @@map("office_size_classification")
}

enum EmployeeCapacityRange {
  Range_1_To_5
  Range_6_To_10
  Range_11_To_15
  Range_16_To_20
  Range_21_To_30
  Range_31_To_40
  Range_41_To_50
  Range_51_To_80
  Range_81_To_100
  Range_101_To_140
  Range_141_To_170
  Range_More_Than_171

  @@map("employee_capacity_range")
}

/// Roles de up_roles (sin `public`, que no se asigna a usuarios).
enum UserRole {
  authenticated
  operator
  supervisor
  administrator
  super_administrator

  @@map("user_role")
}

enum SyncRunStatus {
  resolving
  running
  completed
  completed_with_skips
  failed
  aborted

  @@map("sync_run_status")
}

enum EtlRunStatus {
  running
  validated
  committed
  rolled_back
  aborted
  failed

  @@map("etl_run_status")
}

enum SyncOperation {
  push
  pull

  @@map("sync_operation")
}

enum SyncBlockMode {
