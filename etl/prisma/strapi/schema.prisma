  rental_price_without_vatusd         Decimal?  @db.Decimal(15, 2)
  rental_price_per_m_2_without_vatusd Decimal?  @db.Decimal(15, 2)
  installment_usd                     Decimal?  @db.Decimal(15, 2)
  income_usd                          Decimal?  @db.Decimal(15, 2)
  unit_absorption                     Decimal?  @db.Decimal(18, 12)
  absorption_per_m_2                  Decimal?  @db.Decimal(18, 12)
  created_at                          DateTime? @db.DateTime(6)
  updated_at                          DateTime? @db.DateTime(6)
  published_at                        DateTime? @db.DateTime(6)
  created_by_id                       Int?      @db.UnsignedInt
  updated_by_id                       Int?      @db.UnsignedInt
  locale                              String?   @db.VarChar(255)
  unit_size_m_2                       Decimal?  @db.Decimal(14, 4)
  total_size_m_2                      Decimal?  @db.Decimal(14, 4)
  parking_size_m_2                    Decimal?  @db.Decimal(14, 4)
  maintenance_total_price_m_2_usd     Decimal?  @db.Decimal(15, 2)
  maintenance_price_per_m_2_usd       Decimal?  @db.Decimal(15, 2)

  block_lnk        units_block_lnk[]
  unit_usage_lnk   units_unit_usage_lnk[]
  topography_lnk   units_topography_lnk[]
  parking_type_lnk units_parking_type_lnk[]
  cmps             units_cmps[]
}

// Declarada oneToOne en Strapi, en la práctica es muchos-a-uno (unidad → bloque).
model units_block_lnk {
  id       Int  @id @default(autoincrement()) @db.UnsignedInt
  unit_id  Int? @db.UnsignedInt
  block_id Int? @db.UnsignedInt

  unit  units?  @relation(fields: [unit_id], references: [id])
  block blocks? @relation(fields: [block_id], references: [id])
}

model units_unit_usage_lnk {
  id            Int  @id @default(autoincrement()) @db.UnsignedInt
  unit_id       Int? @db.UnsignedInt
  unit_usage_id Int? @db.UnsignedInt

  unit       units?       @relation(fields: [unit_id], references: [id])
  unit_usage unit_usages? @relation(fields: [unit_usage_id], references: [id])
}

model units_topography_lnk {
  id                 Int  @id @default(autoincrement()) @db.UnsignedInt
  unit_id            Int? @db.UnsignedInt
  unit_topography_id Int? @db.UnsignedInt

  unit            units?             @relation(fields: [unit_id], references: [id])
  unit_topography unit_topographies? @relation(fields: [unit_topography_id], references: [id])
}

model units_parking_type_lnk {
  id                   Int  @id @default(autoincrement()) @db.UnsignedInt
  unit_id              Int? @db.UnsignedInt
  unit_parking_type_id Int? @db.UnsignedInt

  unit              units?              @relation(fields: [unit_id], references: [id])
  unit_parking_type unit_parking_types? @relation(fields: [unit_parking_type_id], references: [id])
}

// Zona dinámica unitType (field = 'unitType'). cmp_id apunta a:
//   unit-types.housing    → components_unit_types_housings
//   unit-types.offices    → components_unit_types_offices
//   unit-types.industrial → components_unit_types_industrials
model units_cmps {
  id             Int     @id @default(autoincrement()) @db.UnsignedInt
  entity_id      Int?    @db.UnsignedInt
  cmp_id         Int?    @db.UnsignedInt
  component_type String? @db.VarChar(255)
  field          String? @db.VarChar(255)
  order          Float?  @db.Double

  entity units? @relation(fields: [entity_id], references: [id])
}

model components_unit_types_housings {
  id                       Int      @id @default(autoincrement()) @db.UnsignedInt
  bedrooms                 Int?
  balcony_terrace_size_m_2 Decimal? @db.Decimal(10, 2)
}

model components_unit_types_offices {
  id                                 Int      @id @default(autoincrement()) @db.UnsignedInt
  employee_capacity                  Int?
  price_without_parking_m_2_usd      Decimal? @db.Decimal(10, 2)
  property_value_without_parking_usd Decimal? @db.Decimal(10, 2)
  office_classification              String?  @db.VarChar(255)
  general_size_classification        String?  @db.VarChar(255)
  employee_capacity_range            String?  @db.VarChar(255)
  m_2_range                          String?  @db.VarChar(255)
  size_employee_capacity_combined    String?  @db.VarChar(255)
  size_m_2_combined                  String?  @db.VarChar(255)
  parking_for_sale                   Int?
  balcony_terrace_size_m_2           Decimal? @db.Decimal(10, 2)
}

model components_unit_types_industrials {
  id                           Int      @id @default(autoincrement()) @db.UnsignedInt
  warehouse_storage_size_m_2   Decimal? @db.Decimal(10, 2)
  office_size_m_2              Decimal? @db.Decimal(10, 2)
  mezzanine_size_m_2           Decimal? @db.Decimal(10, 2)
  loading_area_m_2             Decimal? @db.Decimal(10, 2)
  width_1_m_2                  Decimal? @db.Decimal(10, 2)
  depth_1_m_2                  Decimal? @db.Decimal(10, 2)
  depth_2_m_2                  Decimal? @db.Decimal(10, 2)
  height_m_2                   Decimal? @db.Decimal(10, 2)
  additional_parking_price_usd Decimal? @db.Decimal(10, 2)
  quality_classification       String?  @db.VarChar(255)
}

// ─────────────────────────────────────────────────────────────────────────────
// Usuarios del backoffice (plugin users-permissions)
// ─────────────────────────────────────────────────────────────────────────────

model up_roles {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  document_id   String?   @db.VarChar(255)
  name          String?   @db.VarChar(255)
  description   String?   @db.VarChar(255)
  type          String?   @db.VarChar(255)
  created_at    DateTime? @db.DateTime(6)
  updated_at    DateTime? @db.DateTime(6)
  published_at  DateTime? @db.DateTime(6)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)

  users_lnk up_users_role_lnk[]
}

// password es un hash bcrypt: se puede migrar tal cual.
model up_users {
  id                   Int       @id @default(autoincrement()) @db.UnsignedInt
  document_id          String?   @db.VarChar(255)
  username             String?   @db.VarChar(255)
  email                String?   @db.VarChar(255)
  provider             String?   @db.VarChar(255)
  password             String?   @db.VarChar(255)
  reset_password_token String?   @db.VarChar(255)
  confirmation_token   String?   @db.VarChar(255)
  confirmed            Boolean?
  blocked              Boolean?
  created_at           DateTime? @db.DateTime(6)
  updated_at           DateTime? @db.DateTime(6)
  published_at         DateTime? @db.DateTime(6)
  created_by_id        Int?      @db.UnsignedInt
  updated_by_id        Int?      @db.UnsignedInt
  locale               String?   @db.VarChar(255)

  role_lnk up_users_role_lnk[]
}

model up_users_role_lnk {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  user_id  Int?   @db.UnsignedInt
  role_id  Int?   @db.UnsignedInt
  user_ord Float? @db.Double

  user up_users? @relation(fields: [user_id], references: [id])
  role up_roles? @relation(fields: [role_id], references: [id])
}
